    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "js-yaml": "^5.4.2",
    "polygon-clipping": "^0.15.7"
  }
