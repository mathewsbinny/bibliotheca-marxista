---
import Base from '../../layouts/Base.astro';
import WorksTable from '../../components/WorksTable.astro';
import { STATUS_LABELS, getInternationalPresses, getInternationalWorks, getInternationals, yearsActive, type International } from '../../lib/catalogue';

export async function getStaticPaths() {
  const internationals = await getInternationals();
  return internationals.map((international) => ({ params: { international: international.id }, props: { international } }));
}

interface Props {
  international: International;
}

const { international } = Astro.props;
const i = international.data;
const presses = await getInternationalPresses(international.id);
const works = await getInternationalWorks(international);
---

<Base
  title={i.name}
  description={i.summary}
  jsonLd={{
    '@type': 'Organization', name: i.name, alternateName: i.alternate_names, description: i.description,
    foundingDate: String(i.founded), dissolutionDate: i.dissolved && String(i.dissolved), sameAs: i.sources.map((s) => s.url).filter((u): u is string => !!u && /wikipedia\.org|wikidata\.org/.test(u)),
  }}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/international">International</a>{i.affiliation && ` · ${i.affiliation}`}</p>
    <h1>{i.name}</h1>
    <span class="status-label">
      <span class={`status-dot ${i.status}`} aria-hidden="true"></span>
      {STATUS_LABELS[i.status]}
    </span>
  </header>
  <p class="lede">{i.description}</p>

  <dl class="record">
    <dt>Years</dt>
    <dd>{yearsActive({ ...i, estimated: [] })}</dd>
    {i.affiliation && (
      <>
        <dt>Tendency</dt>
        <dd>{i.affiliation}</dd>
      </>
    )}
    {i.alternate_names.length > 0 && (
      <>
        <dt>Also known as</dt>
        <dd>{i.alternate_names.join(' · ')}</dd>
      </>
    )}
    {presses.length > 0 && (
      <>
        <dt>Publishing houses</dt>
        <dd>{presses.map((p, n) => <>{n > 0 && ' · '}<a href={`/publishers/${p.id}`}>{p.data.name}</a></>)}</dd>
      </>
    )}
    {i.sources.length > 0 && (
      <>
        <dt>Sources</dt>
        <dd>{i.sources.map((s, n) => <>{n > 0 && '; '}{s.url ? <a href={s.url}>{s.title}</a> : s.title}</>)}</dd>
      </>
    )}
  </dl>

  <h2>Titles</h2>
  <p class="meta">
    The backlists of its own publishing houses, and works credited to it or its executive bodies
    and congresses printed while it was active. Titles in this catalogue link to their page.
  </p>
  <WorksTable works={works} />
</Base>
