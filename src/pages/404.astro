---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <h1>Page not found</h1>
  <p class="lede" data-message>
    There is no page at this address. Try the <a href="/publishers">publishers</a> or
    <a href="/titles">all titles</a>.
  </p>
</Base>

<script>
  // Titles used to have a page each at /publishers/<publisher>/<title>/; they now share one page.
  const old = location.pathname.match(/^\/publishers\/([^/]+)\/([^/]+)\/?$/);
  // The globe moved from its own page to the home page.
  if (location.pathname === '/globe' || location.pathname === '/globe/') location.replace('/');
  if (old) {
    const [, publisher, title] = old.map(decodeURIComponent);
    location.replace(`/title/?p=${encodeURIComponent(publisher)}&t=${encodeURIComponent(title)}`);
  }
</script>
