---
import Base from '../../layouts/Base.astro';
import WorksTable from '../../components/WorksTable.astro';
import { STATUS_LABELS, getMovementWorks, getMovements, names, yearsActive, type Movement } from '../../lib/catalogue';

export async function getStaticPaths() {
  const movements = await getMovements();
  return movements.map((movement) => ({ params: { movement: movement.id }, props: { movement } }));
}

interface Props {
  movement: Movement;
}

const { movement } = Astro.props;
const m = movement.data;
const works = await getMovementWorks(movement);
const credited = [m.name, ...m.alternate_names, ...m.credits];
---

<Base
  title={m.name}
  description={m.description}
  jsonLd={{
    '@type': 'Organization', name: m.name, alternateName: m.alternate_names, description: m.description,
    foundingDate: m.founded && String(m.founded), dissolutionDate: m.dissolved && String(m.dissolved),
    location: m.region ? `${m.region}, ${m.country}` : m.country, sameAs: m.sources.map((s) => s.url).filter((u): u is string => !!u && /wikipedia\.org|wikidata\.org/.test(u)),
  }}
>
  <header class="page-head">
    <p class="eyebrow"><a href="/publishers#movements">Movements</a> · {m.country}</p>
    <h1>{m.name}</h1>
    <span class="status-label">
      <span class={`status-dot ${m.status}`} aria-hidden="true"></span>
      {STATUS_LABELS[m.status]}
    </span>
  </header>
  <p class="lede">{m.description}</p>

  <dl class="record">
    <dt>Years</dt>
    <dd>{yearsActive({ ...m, estimated: [] })}</dd>
    <dt>Country</dt>
    <dd>{m.region ? `${m.region}, ${m.country}` : m.country}</dd>
    {m.alternate_names.length > 0 && (
      <>
        <dt>Also known as</dt>
        <dd>{m.alternate_names.join(' · ')}</dd>
      </>
    )}
    {m.affiliation && (
      <>
        <dt>Affiliation</dt>
        <dd>{m.affiliation}</dd>
      </>
    )}
    {m.sources.length > 0 && (
      <>
        <dt>Sources</dt>
        <dd>
          {m.sources.map((s, i) => (
            <>
              {i > 0 && '; '}
              {s.url ? <a href={s.url}>{s.title}</a> : s.title}
            </>
          ))}
        </dd>
      </>
    )}
  </dl>

  <h2>{m.region ? 'Works' : 'Works published abroad'}</h2>
  <p class="meta">
    The movement's own publications{m.region ? ', and works by its members' : ', wherever they were printed'}. Each keeps its real publisher;
    titles in this catalogue link to their page. Works credited to {names(credited)} are included automatically.
  </p>
  <WorksTable works={works} />
</Base>
