---
import Base from '../../layouts/Base.astro';
import CatalogueTable from '../../components/CatalogueTable.astro';
import Timeline from '../../components/Timeline.astro';
import { identifierLinks } from '../../lib/schemas';
import { getAuthors, getPublishers, getTitlesByAuthor, type Author } from '../../lib/catalogue';

export async function getStaticPaths() {
  const authors = await getAuthors();
  return authors.map((author) => ({ params: { author: author.id }, props: { author } }));
}

interface Props {
  author: Author;
}

const { author } = Astro.props;
const a = author.data;
const editions = await getTitlesByAuthor(author);
const publisherNames = new Map((await getPublishers()).map((p) => [p.id, p.data.name]));
// The author's records elsewhere (Wikidata, VIAF, the Library of Congress…), for readers and for linked data.
const authorities = identifierLinks(a.identifiers);
const works = [...a.works].sort((x, y) => x.year - y.year || x.title.localeCompare(y.title));
---

<Base
  title={a.name}
  description={a.description}
  ogType="profile"
  jsonLd={{
    '@type': 'Person', name: a.name, alternateName: a.alternate_names, description: a.description,
    birthDate: a.born && String(a.born), deathDate: a.died && String(a.died), nationality: a.nationality,
    sameAs: [...new Set([...authorities.map((l) => l.url), ...a.sources.map((s) => s.url).filter((u): u is string => !!u && /wikipedia\.org|wikidata\.org/.test(u))])],
  }}
>
  <p class="eyebrow"><a href="/authors">Authors</a>{a.nationality && ` · ${a.nationality}`}</p>
  <h1>{a.name}</h1>
  <p class="lede">{a.description}</p>

  <dl class="record">
    {a.born && (
      <>
        <dt>Lived</dt>
        <dd>{a.born}–{a.died ?? ''}</dd>
      </>
    )}
    {!a.born && a.active && (
      <>
        <dt>Active</dt>
        <dd>{a.active}</dd>
      </>
    )}
    {a.alternate_names.length > 0 && (
      <>
        <dt>Also known as</dt>
        <dd>{a.alternate_names.join(' · ')}</dd>
      </>
    )}
    {authorities.length > 0 && (
      <>
        <dt>Authority records</dt>
        <dd>{authorities.map((l, i) => <>{i > 0 && ' · '}<a href={l.url}>{l.label}</a></>)}</dd>
      </>
    )}
    {a.sources.length > 0 && (
      <>
        <dt>Sources</dt>
        <dd>{a.sources.map((s, i) => <>{i > 0 && '; '}{s.url ? <a href={s.url}>{s.title}</a> : s.title}</>)}</dd>
      </>
    )}
  </dl>

  {works.length === 0 && editions.length === 0 && (
    <p class="meta">{a.name}’s work is yet to be catalogued.</p>
  )}

  {works.length > 0 && <><h2>Bibliography</h2>
  <p class="meta">First editions. A tick marks a work matched to a library catalogue record.</p>
  <div class="table-wrap">
    <table class="catalogue">
      <thead>
        <tr>
          <th scope="col">Year</th>
          <th scope="col">Title</th>
          <th scope="col">First published by</th>
          <th scope="col">Records</th>
        </tr>
      </thead>
      <tbody>
        {works.map((w) => (
          <tr>
            <td class="year">{w.year}</td>
            <td>
              {w.title}
              {w.verified && <span class="tick" title="Verified against a library catalogue record">✓</span>}
              {w.subtitle && <span class="meta"> — {w.subtitle}</span>}
              {w.role !== 'author' && <span class="meta"> ({w.role})</span>}
              {w.notes && <div class="meta">{w.notes}</div>}
            </td>
            <td>
              {w.publisher_id
                ? <a href={`/publishers/${w.publisher_id.id}`}>{w.publisher}</a>
                : w.publisher}
              {w.place && <span class="meta">, {w.place}</span>}
            </td>
            <td class="meta">
              {[...w.links.map((l) => ({ title: l.label, url: l.url })), ...w.sources.filter((s) => s.url).slice(0, 2)]
                .map((s, i) => <>{i > 0 && ' · '}<a href={s.url}>{s.title.replace(/ \(.*\)$/, '').replace(/ edition .*$/, '')}</a></>)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div></>}

  {(works.length > 0 || editions.length > 0) && <h2>Editions in the catalogue</h2>}
  {editions.length > 4 && (
    <Timeline years={editions.map((t) => t.year)} label={`Editions of ${a.name} by year`}
      marks={a.died ? [{ year: a.died, label: `Died ${a.died}` }] : []} />
  )}
  {editions.length > 0
    ? <CatalogueTable titles={editions} publisherNames={publisherNames} scope={{ author: author.id }} />
    : works.length > 0 && <p class="meta">No editions by {a.name} are catalogued under any of the publishers yet.</p>}
</Base>
