---
/**
 * The title page's frame. Each title's page is /book/<publisher>/<title>, rendered by the catalogue
 * API (server/book.mjs), which fills this page in: the build stores it in the catalogue database as
 * the template (scripts/build-db.mjs). Opened itself, at its old address (/title/?p=…&t=…), it sends
 * the reader on to the title's page.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Title" description="A catalogued title." noindex>
  <div class="title-record">
    <p class="meta" data-status>Opening this title's page…</p>
    <noscript><p class="meta">This is an old address for a title, which needs JavaScript to forward you. Search for the title under <a href="/titles">All titles</a>.</p></noscript>
  </div>
</Base>

<script>
  import { titleHref } from '../lib/shard';

  const root = document.querySelector<HTMLElement>('.title-record')!;

  // A title's page as the API rendered it: copying a citation, and sending a report in place.
  for (const button of root.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copy!)?.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select and copy the text';
      }
      setTimeout(() => (button.textContent = 'Copy'), 2000);
    });
  }
  const form = root.querySelector<HTMLFormElement>('.report-form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-report-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    button.disabled = true;
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (res.status === 429) throw new Error('Too many reports have been sent from here this hour. Please try again later.');
      if (!res.ok) throw new Error('The report could not be sent. Please try again in a moment.');
      form.reset();
      status.textContent = 'Thank you: your report has been received, and will be checked against the library records.';
    } catch (e) {
      status.textContent = (e as Error).message;
    } finally {
      button.disabled = false;
    }
  });

  // Opened at a title's old address: on to its page.
  if (!root.hasAttribute('data-rendered')) {
    const params = new URLSearchParams(location.search);
    const publisher = params.get('p'), title = params.get('t');
    if (publisher && title) location.replace(titleHref(publisher, title));
    else {
      document.title = 'Title not found · Bibliotheca Marxista';
      const status = root.querySelector<HTMLElement>('[data-status]')!;
      status.textContent = 'This title could not be found. Try searching ';
      status.append(Object.assign(document.createElement('a'), { href: '/titles', textContent: 'all titles' }), '.');
    }
  }
</script>
