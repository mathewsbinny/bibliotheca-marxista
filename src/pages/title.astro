---
/**
 * The title page's frame. Each title's page is /book/<publisher>/<title>, rendered by the catalogue
 * API (server/book.mjs), which fills this page in: the build stores it in the catalogue database as
 * the template (scripts/build-db.mjs). Opened itself, at its old address (/title/?p=…&t=…), it sends
 * the reader on to the title's page.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Title" description="A catalogued title." noindex>
  <div class="title-record">
    <p class="meta" data-status>Opening this title's page…</p>
    <noscript><p class="meta">This is an old address for a title, which needs JavaScript to forward you. Search for the title under <a href="/titles">All titles</a>.</p></noscript>
  </div>
</Base>

<script>
  import { titleHref } from '../lib/shard';

  const root = document.querySelector<HTMLElement>('.title-record')!;
  // A page the API rendered needs nothing more.
  if (!root.hasAttribute('data-rendered')) {
    const params = new URLSearchParams(location.search);
    const publisher = params.get('p'), title = params.get('t');
    if (publisher && title) location.replace(titleHref(publisher, title));
    else {
      document.title = 'Title not found · Bibliotheca Marxista';
      const status = root.querySelector<HTMLElement>('[data-status]')!;
      status.textContent = 'This title could not be found. Try searching ';
      status.append(Object.assign(document.createElement('a'), { href: '/titles', textContent: 'all titles' }), '.');
    }
  }
</script>
