---
import Base from '../layouts/Base.astro';
import CatalogueFilters from '../components/CatalogueFilters.astro';
import { findAuthor, getAuthorIndex, getPublishers, getTitles, isFree, languagesOf, titleDate } from '../lib/catalogue';
import { getTitlePlaces } from '../lib/globe-places';

const titles = await getTitles();
const publishers = (await getPublishers()).map((p) => ({ id: p.id, name: p.data.name }));
// The globe's countries and regions that have titles, for the country filter.
const countries = [...new Set([...(await getTitlePlaces()).values()].flat())].sort((a, b) => a.localeCompare(b));
// The earliest titles, written into the page so it shows titles before any search; filters and
// searches ask the catalogue API (src/lib/api.ts).
const PAGE = 50;
const publisherName = new Map(publishers.map((p) => [p.id, p.name]));
const earliest = titles.filter((t) => t.year).sort((a, b) => a.year! - b.year!).slice(0, PAGE);
const authorIndex = await getAuthorIndex();
// Joins credits as names() does: "A & B", "A, B & C".
const separator = (i: number, n: number) => (i === 0 ? '' : i === n - 1 ? ' & ' : ', ');
---

<Base centered title="Titles" description="Search every title in the catalogue: books and pamphlets of socialist, communist and Marxist publishers, by title, author, publisher, language and year.">
  <h1>All titles</h1>
  <p class="lede">
    Every catalogued title across all publishers. Search by title, author or series (suggestions
    appear as you type), narrow by language, decade, country (as on the globe) or publisher with the
    counts below, and sort by title, author, publisher or year. The data can also be downloaded as <a href="/about#download">JSON</a>.
  </p>

  <noscript>
    <p class="meta">Searching and filtering need JavaScript. Every house's titles can still be browsed from its page under <a href="/publishers">Publishers</a>.</p>
  </noscript>

  <div class="title-search" data-publishers={JSON.stringify(Object.fromEntries(publishers.map((p) => [p.id, p.name])))}>
    <CatalogueFilters languages={languagesOf(titles)} countries={countries} publishers={publishers} total={titles.length} search />
    <!-- The counts fold away behind their heading: open on wide screens, closed on phones (the script below). -->
    <details class="facets-panel" hidden>
      <summary>Narrow by language, decade, country or publisher</summary>
      <section class="facets" aria-label="Narrow the titles">
        {[['lang', 'Language'], ['decade', 'Decade'], ['country', 'Country'], ['pub', 'Publisher']].map(([name, label]) => (
          <div class="facet" data-facet={name}>
            <h3>{label}</h3>
            <ul></ul>
            <button type="button" class="facet-more button-small" aria-expanded="false" hidden>More</button>
          </div>
        ))}
      </section>
    </details>
    <div class="table-wrap">
      <table class="catalogue">
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Title</th>
            <th scope="col">Author(s)</th>
            <th scope="col">Publisher</th>
          </tr>
        </thead>
        <tbody>
          {earliest.map((t) => (
            <tr>
              <td class="year">{titleDate(t)}</td>
              <td>
                <a href={t.href}>{t.title}</a>
                {t.verified && <span class="tick" title="Verified against a library catalogue record">✓</span>}
                {isFree(t) && <span class="free-mark" title="A free copy is linked">Free</span>}
                {t.subtitle && <span class="meta"> — {t.subtitle}</span>}
              </td>
              <td>
                {t.authors.length ? t.authors.map((name, i) => {
                  const author = findAuthor(authorIndex, name);
                  return <>{separator(i, t.authors.length)}{author ? <a href={`/authors/${author.id}`}>{name}</a> : name}</>;
                }) : '—'}
              </td>
              <td><a href={`/publishers/${t.publisherId}`}>{publisherName.get(t.publisherId)}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="meta" data-status role="status">The {PAGE} earliest of {titles.length.toLocaleString('en')} titles. Search or choose a filter to explore the rest.</p>
    <button type="button" class="more" hidden>Show more</button>
  </div>
</Base>

<script>
  import { fetchFacets, fetchSuggestions, fetchTitles, titleParams, type Facets, type Suggestion } from '../lib/api';
  import { readCriteria, restoreFromUrl } from '../lib/filters';
  import { FREE, VERIFIED, type Row } from '../lib/rows-shared';

  const PAGE = 50;

  const root = document.querySelector<HTMLElement>('.title-search')!;
  const form = root.querySelector('form')!;
  const tbody = root.querySelector('tbody')!;
  const count = root.querySelector('[data-count]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const more = root.querySelector<HTMLButtonElement>('.more')!;
  const publisherNames: Record<string, string> = JSON.parse(root.dataset.publishers ?? '{}');

  let params = new URLSearchParams();
  let total = 0;
  let shown = 0;
  let generation = 0;

  const cell = (text: string, className?: string) => {
    const td = document.createElement('td');
    td.textContent = text;
    if (className) td.className = className;
    return td;
  };

  /** The authors, each linked to their page when they have one, joined as "A, B & C". */
  const authorsCell = (row: Row) => {
    const links = row[11];
    if (!links.length) return cell(row[4] || '—');
    const td = cell('');
    links.forEach(([name, id], i) => {
      if (i) td.append(i === links.length - 1 ? ' & ' : ', ');
      td.append(id ? Object.assign(document.createElement('a'), { href: '/authors/' + id, textContent: name }) : name);
    });
    return td;
  };

  const draw = (row: Row) => {
    const [href, title, subtitle, , , date, , , flags, pub] = row;
    const tr = document.createElement('tr');
    const t = cell('');
    t.append(Object.assign(document.createElement('a'), { href, textContent: title }));
    if (flags & VERIFIED) t.append(Object.assign(document.createElement('span'), { className: 'tick', textContent: '✓', title: 'Verified against a library catalogue record' }));
    if (flags & FREE) t.append(Object.assign(document.createElement('span'), { className: 'free-mark', textContent: 'Free', title: 'A free copy is linked' }));
    if (subtitle) t.append(Object.assign(document.createElement('span'), { className: 'meta', textContent: ' — ' + subtitle }));
    const p = cell('');
    p.append(Object.assign(document.createElement('a'), { href: '/publishers/' + pub, textContent: publisherNames[pub] ?? pub }));
    tr.append(cell(date, 'year'), t, authorsCell(row), p);
    return tr;
  };

  const showStatus = () => {
    more.hidden = shown >= total;
    more.disabled = false;
    status.textContent = total
      ? 'Showing ' + shown.toLocaleString('en') + ' of ' + total.toLocaleString('en') + ' matches.'
      : 'No titles match these filters.';
  };

  async function renderMore() {
    const current = generation;
    more.disabled = true;
    const page = await fetchTitles(params, shown, PAGE);
    if (current !== generation) return; // a newer search has started
    tbody.append(...page.rows.map(draw));
    shown += page.rows.length;
    if (!page.rows.length) total = shown;
    showStatus();
  }

  // The page as built: the earliest titles, restored when every filter is cleared.
  const initialRows = [...tbody.children];
  const initialStatus = status.textContent;
  const initialCount = count.textContent;

  async function apply() {
    const current = ++generation;
    const c = readCriteria(form);
    const unfiltered = !c.terms.length && !c.lang && !c.pub && !c.country && !c.series && !c.verified && !c.access && !c.sort
      && c.from === -Infinity && c.to === Infinity;
    showSeries();
    refreshFacets(unfiltered ? new URLSearchParams() : titleParams(c));
    if (unfiltered) {
      tbody.replaceChildren(...initialRows);
      status.textContent = initialStatus;
      count.textContent = initialCount;
      more.hidden = true;
      return;
    }
    params = titleParams(c);
    status.textContent = 'Searching…';
    const page = await fetchTitles(params, 0, PAGE);
    if (current !== generation) return;
    total = page.total ?? 0;
    count.textContent = total.toLocaleString('en');
    tbody.replaceChildren(...page.rows.map(draw));
    shown = page.rows.length;
    showStatus();
  }

  const searchFailed = () => {
    status.textContent = 'The search could not be completed: the catalogue did not answer. Check your connection, or try again in a moment.';
    more.disabled = false;
  };
  // The series filter: a hidden field, shown as a chip that removes it.
  const seriesField = form.elements.namedItem('series') as HTMLInputElement;
  const chip = form.querySelector<HTMLElement>('[data-series-chip]')!;
  function showSeries() {
    chip.hidden = !seriesField.value;
    chip.querySelector('[data-series-name]')!.textContent = seriesField.value;
  }
  const setField = (name: string, value: string) => {
    const field = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
    // A value the list does not offer (a rare country or language) is added to it.
    if (field instanceof HTMLSelectElement && value && ![...field.options].some((o) => o.value === value)) field.add(new Option(value, value));
    field.value = value;
  };
  const changed = () => form.dispatchEvent(new Event('input', { bubbles: true }));
  chip.querySelector('[data-series-clear]')!.addEventListener('click', () => {
    setField('series', '');
    changed();
    (form.elements.namedItem('q') as HTMLInputElement).focus();
  });

  // Facets: how the titles found divide by language, decade, country and publisher. A value
  // narrows the search to it; pressed again, it widens it back.
  const facets = root.querySelector<HTMLElement>('.facets')!;
  // The counts' fold: open on wide screens, closed on phones, where they would push the titles
  // below the fold. The reader may open or close it either way.
  const facetsPanel = root.querySelector<HTMLDetailsElement>('.facets-panel')!;
  facetsPanel.open = window.matchMedia('(min-width: 40.01rem)').matches;
  const SHOWN = 8;
  let facetRequest: AbortController | undefined;
  const fieldValue = (name: string) => (form.elements.namedItem(name) as HTMLInputElement).value;
  function facetLabel(name: string, value: string | number) {
    if (name === 'decade') return value + 's';
    if (name === 'pub') return publisherNames[value] ?? String(value);
    return String(value);
  }
  function isActive(name: string, value: string | number) {
    if (name === 'decade') return fieldValue('from') === String(value) && fieldValue('to') === String(Number(value) + 9);
    return fieldValue(name) === String(value);
  }
  function drawFacets(data: Facets) {
    for (const group of facets.querySelectorAll<HTMLElement>('[data-facet]')) {
      const name = group.dataset.facet as keyof Facets;
      const more = group.querySelector<HTMLButtonElement>('.facet-more')!;
      const open = more.getAttribute('aria-expanded') === 'true';
      const values = data[name] ?? [];
      group.querySelector('ul')!.replaceChildren(...values.map(([value, n], i) => {
        const li = document.createElement('li');
        li.hidden = i >= SHOWN && !open;
        const button = Object.assign(document.createElement('button'), { type: 'button', className: 'facet-value' });
        button.setAttribute('aria-pressed', String(isActive(name, value)));
        button.append(facetLabel(name, value), ' ', Object.assign(document.createElement('span'), { className: 'n', textContent: n.toLocaleString('en') }));
        button.addEventListener('click', () => {
          const off = isActive(name, value);
          if (name === 'decade') {
            setField('from', off ? '' : String(value));
            setField('to', off ? '' : String(Number(value) + 9));
          } else setField(name, off ? '' : String(value));
          changed();
        });
        li.append(button);
        return li;
      }));
      more.hidden = values.length <= SHOWN;
      group.hidden = !values.length;
    }
    facetsPanel.hidden = false;
  }
  facets.querySelectorAll<HTMLButtonElement>('.facet-more').forEach((more) => more.addEventListener('click', () => {
    const open = more.getAttribute('aria-expanded') !== 'true';
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? 'Fewer' : 'More';
    more.closest('.facet')!.querySelectorAll<HTMLElement>('li').forEach((li, i) => { li.hidden = i >= SHOWN && !open; });
  }));
  function refreshFacets(p: URLSearchParams) {
    facetRequest?.abort();
    facetRequest = new AbortController();
    fetchFacets(p, facetRequest.signal).then(drawFacets).catch((e) => { if (e.name !== 'AbortError') facetsPanel.hidden = true; });
  }

  // Suggestions as the reader types: a combobox (WAI-ARIA), chosen with the arrow keys and Enter,
  // or the mouse. An author or publisher opens their page; a series narrows the titles to it.
  const q = form.elements.namedItem('q') as HTMLInputElement;
  const listbox = form.querySelector<HTMLUListElement>('#search-suggestions')!;
  const KINDS = { author: 'Author', publisher: 'Publisher', series: 'Series' };
  let suggestions: Suggestion[] = [];
  let active = -1;
  let suggestRequest: AbortController | undefined;
  let suggestTimer: number | undefined;
  function closeSuggestions() {
    listbox.hidden = true;
    q.setAttribute('aria-expanded', 'false');
    q.removeAttribute('aria-activedescendant');
    active = -1;
  }
  function highlight(i: number) {
    active = i;
    listbox.querySelectorAll('[role=option]').forEach((o, j) => o.setAttribute('aria-selected', String(j === i)));
    q.setAttribute('aria-activedescendant', 'suggestion-' + i);
  }
  function choose(s: Suggestion) {
    closeSuggestions();
    if (s.kind === 'series') {
      setField('series', s.label);
      q.value = '';
      changed();
    } else if (/^\/(authors|publishers)\/[\w-]+$/.test(s.href)) {
      // Only an author's or a publisher's page: an address from the API is never followed elsewhere.
      location.href = s.href;
    }
  }
  function showSuggestions(list: Suggestion[]) {
    suggestions = list;
    listbox.replaceChildren(...list.map((s, i) => {
      const li = Object.assign(document.createElement('li'), { id: 'suggestion-' + i });
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', 'false');
      li.append(Object.assign(document.createElement('span'), { className: 'suggestion-label', textContent: s.label }),
        Object.assign(document.createElement('span'), { className: 'meta', textContent: ' ' + KINDS[s.kind] + ' · ' + s.titles.toLocaleString('en') + (s.titles === 1 ? ' title' : ' titles') }));
      li.addEventListener('mousedown', (e) => e.preventDefault()); // keeps the focus in the box
      li.addEventListener('click', () => choose(s));
      return li;
    }));
    const open = list.length > 0 && document.activeElement === q;
    listbox.hidden = !open;
    q.setAttribute('aria-expanded', String(open));
    q.removeAttribute('aria-activedescendant');
    active = -1;
  }
  q.addEventListener('input', () => {
    clearTimeout(suggestTimer);
    suggestRequest?.abort();
    if (q.value.trim().length < 2) return closeSuggestions();
    suggestTimer = window.setTimeout(() => {
      suggestRequest = new AbortController();
      fetchSuggestions(q.value.trim(), suggestRequest.signal).then(showSuggestions).catch(() => {});
    }, 150);
  });
  q.addEventListener('keydown', (e) => {
    if (listbox.hidden || !suggestions.length) return;
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const n = suggestions.length;
      highlight(e.key === 'ArrowDown' ? (active + 1) % n : (active - 1 + n) % n);
    } else if (e.key === 'Enter' && active >= 0) {
      e.preventDefault();
      choose(suggestions[active]);
    } else if (e.key === 'Escape') {
      e.preventDefault();
      closeSuggestions();
    }
  });
  q.addEventListener('blur', closeSuggestions);

  let timer: number | undefined;
  form.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(() => apply().catch(searchFailed), 250); });
  more.addEventListener('click', () => renderMore().catch(searchFailed));
  // A linked search runs at once; otherwise the earliest titles stay until the reader searches.
  if (restoreFromUrl(form)) apply().catch(searchFailed);
  else refreshFacets(new URLSearchParams());
</script>
