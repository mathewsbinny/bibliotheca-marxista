---
interface Props {
  languages: string[];
  /** When given, a publisher filter is shown. */
  publishers?: { id: string; name: string }[];
  /** When given, a country filter is shown: the globe's countries and regions. */
  countries?: string[];
  total: number;
  /**
   * The all-titles search: suggestions of authors, publishers and series as the reader types (a
   * combobox, filled by the page's script), and a series filter shown as a removable chip.
   */
  search?: boolean;
}

const { languages, publishers = [], countries = [], total, search = false } = Astro.props;
---

<form class="filters" role="search">
  {search ? (
    <div class="suggest-wrap">
      <label for="search-q">Search title, author, series…</label>
      <input type="search" name="q" id="search-q" autocomplete="off" role="combobox" aria-autocomplete="list"
        aria-expanded="false" aria-controls="search-suggestions" />
      <ul id="search-suggestions" class="suggestions" role="listbox" aria-label="Suggestions" hidden></ul>
    </div>
  ) : (
    <label>
      Search title, author, series…
      <input type="search" name="q" autocomplete="off" />
    </label>
  )}
  {search && (
    <p class="series-chip" data-series-chip hidden>
      <input type="hidden" name="series" />
      Series: <strong data-series-name></strong>
      <button type="button" class="button-small" data-series-clear aria-label="Remove the series filter">×</button>
    </p>
  )}
  <label>
    From
    <input type="number" name="from" inputmode="numeric" placeholder="year" />
  </label>
  <label>
    To
    <input type="number" name="to" inputmode="numeric" placeholder="year" />
  </label>
  {languages.length > 1 && (
    <label>
      Language
      <select name="lang">
        <option value="">All</option>
        {languages.map((l) => <option value={l}>{l}</option>)}
      </select>
    </label>
  )}
  {countries.length > 1 && (
    <label>
      Country
      <select name="country">
        <option value="">All</option>
        {countries.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
  )}
  {publishers.length > 1 && (
    <label>
      Publisher
      <select name="pub">
        <option value="">All</option>
        {publishers.map((p) => <option value={p.id}>{p.name}</option>)}
      </select>
    </label>
  )}
  <label>
    Sort by
    <select name="sort">
      <option value="">Catalogue order</option>
      <option value="title">Title (A–Z)</option>
      <option value="author">Author (A–Z)</option>
      {publishers.length > 1 && <option value="publisher">Publisher (A–Z)</option>}
      <option value="year">Year (oldest first)</option>
      <option value="year-desc">Year (newest first)</option>
    </select>
  </label>
  <label>
    Verification
    <select name="verified">
      <option value="">All titles</option>
      <option value="1">Verified only</option>
      <option value="0">Unverified only</option>
    </select>
  </label>
  <label>
    Access
    <select name="access">
      <option value="">All titles</option>
      <option value="free">Free to read</option>
    </select>
  </label>
  <span class="count" aria-live="polite"><span data-count>{total.toLocaleString('en')}</span> of {total.toLocaleString('en')} titles</span>
</form>

<script>
  // The filters apply as they change; Enter must not send the form and reload the page. (A
  // handler in the page, onsubmit="…", would be blocked by the Content-Security-Policy.)
  for (const form of document.querySelectorAll<HTMLFormElement>('form.filters')) form.addEventListener('submit', (e) => e.preventDefault());
</script>
