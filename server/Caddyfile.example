# The whole site on one host behind Caddy: the static pages from dist/, and the catalogue API for the
# paths it serves (the API itself, each title's page, and the titles' sitemaps), so that titles'
# pages are on the site's own address for search engines. Caddy obtains the HTTPS certificate and
# compresses responses. Copy to /etc/caddy/Caddyfile, set the domain, and upload dist/ to
# /srv/bibliotheca/dist (see README, "Deploying").
{
	servers {
		# Only if Cloudflare is in front of this host: trust its addresses, so that {client_ip} is the
		# visitor's (from CF-Connecting-IP) rather than Cloudflare's. Without Cloudflare, remove this
		# block. Cloudflare's ranges: https://www.cloudflare.com/ips/
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

bibliothecamarxista.org {
	encode zstd gzip

	@api path /api/* /book/* /sitemap-books-*
	handle @api {
		reverse_proxy localhost:8787 {
			# The API limits requests by this address (TRUST_PROXY=1). Caddy sets it, replacing any
			# value a client sends, so it cannot be forged.
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		root * /srv/bibliotheca/dist
		# The site's security headers, written by the build (scripts/write-headers.mjs).
		import /srv/bibliotheca/dist/headers.caddy
		file_server
	}

	# The API not answering (down or restarting): a page saying so, rather than "not found".
	handle_errors 502 503 504 {
		root * /srv/bibliotheca/dist
		rewrite * /unavailable/index.html
		file_server
	}
	# A page that does not exist: the site's own 404 page (which also forwards old addresses).
	handle_errors {
		root * /srv/bibliotheca/dist
		rewrite * /404.html
		file_server
	}
}

www.bibliothecamarxista.org {
	redir https://bibliothecamarxista.org{uri} permanent
}
